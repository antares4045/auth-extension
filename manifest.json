{
  "manifest_version": 3,
  "name": "Universal Auth Injector",
  "version": "1.1.6",
  "permissions": ["storage", "webNavigation", "tabs"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "assets/icon.png"
  },
    "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["assets/crypto-js.js", "content/content.js"],
    "run_at": "document_start"
  }]
}